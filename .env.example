# Backend server
PORT=3001
BASE_URL=http://localhost:3001
NODE_ENV=production

# SwiftPay payment config
SWIFTPAY_MODE=live
SWIFTPAY_API_BASE_URL=https://api.pay.live.swiftpay.ph
SWIFTPAY_API_KEY=your_live_swiftpay_access_key_here
SWIFTPAY_API_SECRET=your_live_swiftpay_secret_key_here
SWIFTPAY_WEBHOOK_SECRET=your_live_swiftpay_webhook_secret_here

# Optional redirect overrides
SWIFTPAY_SUCCESS_URL=${BASE_URL}/order-tracking.html?status=success
SWIFTPAY_FAILURE_URL=${BASE_URL}/checkout.html?status=failed
SWIFTPAY_CANCEL_URL=${BASE_URL}/checkout.html?status=cancelled

# Production deploy notes:
# - Set BASE_URL to your public domain, e.g. https://shop.drl-softechs.dev
# - Register this webhook URL in SwiftPay: ${BASE_URL}/api/swiftpay/webhook
# - Use sandbox while testing; switch to live only when credentials are confirmed
