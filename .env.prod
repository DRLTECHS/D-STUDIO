# ============================================================================
# D-STUDIO PRODUCTION ENVIRONMENT
# ============================================================================
# This file contains the live configuration for the D-Studio storefront.
# Keep this file secure and never commit it to version control.
# Use: cp .env.example .env and fill in your actual values
# ============================================================================

# Backend Server Configuration
PORT=3001
BASE_URL=https://your-domain.com
NODE_ENV=production

# ============================================================================
# SwiftPay Live Payment Configuration
# ============================================================================
# Get your live credentials from your SwiftPay merchant dashboard at:
# https://dashboard.swiftpay.ph/
#
# Sandbox (for testing):
#   API Base: https://api.pay.sandbox.live.swiftpay.ph
#   Mode: sandbox
#
# Production (for live payments):
#   API Base: https://api.pay.live.swiftpay.ph
#   Mode: live
#
# WARNING: Never use sandbox credentials in production. Always use live keys
# and set MODE=live for real payment processing.
# ============================================================================

SWIFTPAY_MODE=live
SWIFTPAY_API_BASE_URL=https://api.pay.live.swiftpay.ph
SWIFTPAY_API_KEY=your_actual_swiftpay_api_key_here
SWIFTPAY_API_SECRET=your_actual_swiftpay_api_secret_here
SWIFTPAY_WEBHOOK_SECRET=your_actual_swiftpay_webhook_secret_here

# ============================================================================
# SwiftPay Redirect URLs (Optional)
# ============================================================================
# These URLs are where customers are redirected after payment attempts.
# If not set, the system uses default redirects to order-tracking.html
# 
# Supported placeholders:
#   {BASE_URL} - replaced with the BASE_URL value
#   {ORDER_NO} - replaced with the order ID
#   {STATUS} - replaced with success/failure/cancelled
#
# Examples:
#   SWIFTPAY_SUCCESS_URL=https://your-domain.com/order-tracking.html?status=success&orderId={ORDER_NO}
#   SWIFTPAY_FAILURE_URL=https://your-domain.com/checkout.html?error=payment_failed
#   SWIFTPAY_CANCEL_URL=https://your-domain.com/checkout.html?status=cancelled
# ============================================================================

SWIFTPAY_SUCCESS_URL=https://your-domain.com/order-tracking.html?status=success
SWIFTPAY_FAILURE_URL=https://your-domain.com/checkout.html?status=failed
SWIFTPAY_CANCEL_URL=https://your-domain.com/checkout.html?status=cancelled

# ============================================================================
# DEPLOYMENT INSTRUCTIONS
# ============================================================================
#
# 1. Update this file with your actual values:
#    - Replace BASE_URL with your public domain
#    - Replace SWIFTPAY_API_KEY with your merchant key
#    - Replace SWIFTPAY_API_SECRET with your merchant secret
#    - Replace SWIFTPAY_WEBHOOK_SECRET with your webhook secret
#
# 2. Register your webhook URL in SwiftPay dashboard:
#    Webhook URL: https://your-domain.com/api/swiftpay/webhook
#
# 3. Deploy with Docker Compose:
#    docker-compose -f docker-compose.prod.yaml pull
#    docker-compose -f docker-compose.prod.yaml up -d
#
# 4. Verify deployment:
#    curl https://your-domain.com/health
#    curl https://your-domain.com/api/swiftpay/institutions
#
# 5. Monitor logs:
#    docker-compose -f docker-compose.prod.yaml logs -f backend
#    docker-compose -f docker-compose.prod.yaml logs -f site
#
# ============================================================================
