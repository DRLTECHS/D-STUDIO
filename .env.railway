# Railway Production Environment Template
# Copy to Railway dashboard or create a .env file locally from this template

# Server Configuration
PORT=3001
NODE_ENV=production
ADMIN_API_KEY=replace-with-a-secure-random-admin-key

# Domain & URL Configuration
BASE_URL=https://your-production-domain.com

# SwiftPay Configuration
# Get these from your SwiftPay merchant dashboard
SWIFTPAY_API_KEY=your_swiftpay_api_key_here
SWIFTPAY_API_SECRET=your_swiftpay_api_secret_here
SWIFTPAY_WEBHOOK_SECRET=your_swiftpay_webhook_secret_here
SWIFTPAY_MODE=live
SWIFTPAY_API_BASE_URL=https://api.pay.live.swiftpay.ph

# SwiftPay Redirect URLs (after payment)
SWIFTPAY_SUCCESS_URL=https://your-production-domain.com/order-tracking.html?status=success
SWIFTPAY_FAILURE_URL=https://your-production-domain.com/checkout.html?status=failed
SWIFTPAY_CANCEL_URL=https://your-production-domain.com/checkout.html?status=cancelled

# Optional: Logging & Debug
LOG_LEVEL=info
