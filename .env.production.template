# ============================================================================
# D-STUDIO RAILWAY PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================================
# Copy this file to Railway Variables tab or save locally as .env.production
# Replace all placeholder values with your actual production values
# Never commit sensitive data to version control
# ============================================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# These settings configure the Node.js server
PORT=3001
NODE_ENV=production

# Your application's public URL (replace with your Railway domain or custom domain)
# Example: https://d-studio-prod-abc123.railway.app
# Or with custom domain: https://app.yourdomain.com
BASE_URL=https://your-railway-domain.railway.app

# ============================================================================
# SWIFTPAY LIVE PAYMENT CONFIGURATION
# ============================================================================
# Get these values from your SwiftPay merchant dashboard at:
# https://dashboard.swiftpay.ph/settings/api-keys
#
# ⚠️  IMPORTANT: Use LIVE credentials, not sandbox
# ⚠️  Never share these values outside your team
# ⚠️  Rotate credentials monthly for security

# Your SwiftPay API Key (live, not sandbox)
# Format: Usually starts with "key_" or similar
SWIFTPAY_API_KEY=your_actual_swiftpay_api_key_here

# Your SwiftPay API Secret (live, not sandbox)
# Format: Usually starts with "secret_" or similar
SWIFTPAY_API_SECRET=your_actual_swiftpay_secret_key_here

# Your SwiftPay Webhook Secret
# Get this from SwiftPay dashboard → Settings → Webhooks
SWIFTPAY_WEBHOOK_SECRET=your_actual_webhook_secret_here

# SwiftPay Mode: MUST be "live" for production
# Never use "sandbox" in production environment
SWIFTPAY_MODE=live

# SwiftPay API Base URL (for live, not sandbox)
# Live URL: https://api.pay.live.swiftpay.ph
# Sandbox URL: https://api.pay.sandbox.live.swiftpay.ph (DO NOT USE)
SWIFTPAY_API_BASE_URL=https://api.pay.live.swiftpay.ph

# ============================================================================
# SWIFTPAY REDIRECT URLS
# ============================================================================
# Where customers are redirected after payment attempts
# Must match your BASE_URL - update the placeholder

# Redirect after successful payment
SWIFTPAY_SUCCESS_URL=https://your-railway-domain.railway.app/order-tracking

# Redirect after failed payment
SWIFTPAY_FAILURE_URL=https://your-railway-domain.railway.app/checkout

# Redirect after cancelled payment
SWIFTPAY_CANCEL_URL=https://your-railway-domain.railway.app/products

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level for application logging
# Values: debug, info, warn, error
# Use "info" for production
LOG_LEVEL=info

# ============================================================================
# OPTIONAL: ADMIN API CONFIGURATION
# ============================================================================
# API key for accessing protected admin endpoints
# Default is "demo-token" - CHANGE THIS in production!
# Generate a secure random string:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Admin API Key (for protected endpoints like /api/admin/orders)
# This should be a secure random token
ADMIN_API_KEY=your-secure-admin-api-key-here

# ============================================================================
# OPTIONAL: DATABASE CONFIGURATION (if using database)
# ============================================================================
# If your application uses a database, configure it here
# Currently D-STUDIO uses mock data, but for production you may want:

# Database connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/dstudio

# Database pool size
# DATABASE_POOL_SIZE=10

# ============================================================================
# OPTIONAL: ERROR TRACKING (Sentry, Rollbar, etc.)
# ============================================================================
# For production error monitoring, configure your service:

# Sentry DSN (for error tracking)
# SENTRY_DSN=https://your-key@sentry.io/project-id

# Rollbar access token
# ROLLBAR_ACCESS_TOKEN=your_rollbar_token_here

# ============================================================================
# OPTIONAL: EMAIL CONFIGURATION
# ============================================================================
# If your application sends emails (order confirmations, etc.)

# Email service provider (gmail, sendgrid, mailgun, etc.)
# EMAIL_PROVIDER=sendgrid

# Email API key
# EMAIL_API_KEY=your_email_service_api_key

# From email address
# EMAIL_FROM=noreply@yourdomain.com

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
#
# To deploy on Railway:
#
# 1. Copy all variables to Railway dashboard:
#    - Go to your project → Service → Variables tab
#    - Paste each variable name and value
#    - Click "Save"
#
# 2. Verify deployment:
#    - Check "Logs" tab for errors
#    - Test health endpoint: curl https://your-domain/health
#    - Verify payment flow
#
# 3. Monitor in production:
#    - View logs: railway logs -f
#    - Check performance metrics
#    - Monitor payment transactions
#
# 4. Webhook registration:
#    - Webhook URL: https://your-railway-domain.railway.app/api/swiftpay/webhook
#    - Register in SwiftPay dashboard → Settings → Webhooks
#    - Test webhook connection
#
# ============================================================================
# SECURITY CHECKLIST
# ============================================================================
#
# Before going live:
#
# ✓ All API keys are LIVE credentials (not sandbox)
# ✓ SWIFTPAY_MODE is set to "live"
# ✓ NODE_ENV is set to "production"
# ✓ All URLs use HTTPS (not HTTP)
# ✓ BASE_URL matches your actual domain
# ✓ Webhook secret is unique and strong
# ✓ Admin API key is changed from default
# ✓ No .env files committed to version control
# ✓ Environment variables are backed up securely
# ✓ Team members have limited access
#
# ============================================================================
